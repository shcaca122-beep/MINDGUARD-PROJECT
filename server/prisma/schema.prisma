generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Siswa {
  id          Int      @id @default(autoincrement())
  nama        String
  email       String   @unique
  mood_status String?
  curhatan    String?
  createdAt   DateTime @default(now())
}

model GuruBK {
  id        Int      @id @default(autoincrement())
  nama      String
  spesialis String
  isOnline  Boolean  @default(false)
}

model JadwalKonsul {
  id        Int      @id @default(autoincrement())
  hari      String
  jam       String
  status    String   @default("Tersedia")
}