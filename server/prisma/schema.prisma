generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Siswa {
  id          Int      @id @default(autoincrement())
  nama        String
  email       String   @unique
  nis         String   @unique
  kelas       String
  mood_status String?
  curhatan    String?
  createdAt   DateTime @default(now())
}

model GuruBK {
  id        Int     @id @default(autoincrement())
  nama      String
  email     String  @unique
  spesialis String
  isOnline  Boolean @default(false)
}

model JadwalKonsul {
  id     Int    @id @default(autoincrement())
  hari   String
  jam    String
  status String @default("Tersedia")
}

model MasterPelanggaran {
  id        Int      @id @default(autoincrement())
  kategori  String   // Ringan, Sedang, Berat
  jenis     String
  poin      Int
  keterangan String?
  createdAt DateTime @default(now())
}